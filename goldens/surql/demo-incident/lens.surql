-- generated by groundworks/lens.py from instance demo_incident; do not edit by hand
-- lens service_owner (perspective, prompt-backed)
REMOVE TABLE IF EXISTS lens_service_owner;
DEFINE TABLE OVERWRITE lens_service_owner AS SELECT id AS label, unit, unit.status AS status, unit.grade AS grade, tier, dir, issues, targets, role, chunk FROM label WHERE unit.status IN ['in_window'] AND (tier >= 2);
-- lens security (discipline, prompt-backed)
REMOVE TABLE IF EXISTS lens_security;
DEFINE TABLE OVERWRITE lens_security AS SELECT id AS label, unit, unit.status AS status, unit.grade AS grade, tier, dir, issues, targets, role, chunk FROM label WHERE unit.status IN ['in_window'] AND unit.grade IN ['original_log'] AND (issues CONTAINS 'config' OR issues CONTAINS 'dependency');
-- lens management (perspective, prompt-backed)
REMOVE TABLE IF EXISTS lens_management;
DEFINE TABLE OVERWRITE lens_management AS SELECT id AS label, unit, unit.status AS status, unit.grade AS grade, tier, dir, issues, targets, role, chunk FROM label WHERE unit.status IN ['in_window'] AND (tier >= 2);
-- frame nodes and the falls_under edge table (label -> consideration)
DEFINE TABLE OVERWRITE consideration SCHEMAFULL;
DEFINE FIELD OVERWRITE lens ON consideration TYPE string;
DEFINE FIELD OVERWRITE source ON consideration TYPE string;
DEFINE FIELD OVERWRITE node ON consideration TYPE string;
DEFINE FIELD OVERWRITE transcribed ON consideration TYPE string;
DEFINE INDEX OVERWRITE consideration_lens ON consideration FIELDS lens;
DEFINE TABLE OVERWRITE falls_under TYPE RELATION IN label OUT consideration SCHEMALESS;
-- frame of lens incident_framework, transcribed from: Incident review template v3, section 2
UPSERT consideration:incident_framework__trigger SET lens="incident_framework", source="Incident review template v3, section 2", node="trigger", transcribed="trigger";
UPSERT consideration:incident_framework__propagation SET lens="incident_framework", source="Incident review template v3, section 2", node="propagation", transcribed="propagation";
UPSERT consideration:incident_framework__detection SET lens="incident_framework", source="Incident review template v3, section 2", node="detection", transcribed="detection";
UPSERT consideration:incident_framework__mitigation SET lens="incident_framework", source="Incident review template v3, section 2", node="mitigation", transcribed="mitigation";
UPSERT consideration:incident_framework__prevention SET lens="incident_framework", source="Incident review template v3, section 2", node="prevention", transcribed="prevention";
DELETE consideration WHERE lens = "incident_framework" AND node NOT IN ["trigger", "propagation", "detection", "mitigation", "prevention"];
