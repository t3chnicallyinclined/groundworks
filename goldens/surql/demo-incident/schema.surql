-- generated by engine/gates.py from instance demo_incident; do not edit by hand
DEFINE TABLE IF NOT EXISTS unit TYPE NORMAL SCHEMAFULL;
ALTER TABLE unit TYPE NORMAL SCHEMAFULL;
DEFINE FIELD OVERWRITE type ON unit TYPE string ASSERT $value IN ['log_line', 'change', 'metric_point'];
DEFINE FIELD OVERWRITE text ON unit TYPE string;
DEFINE FIELD OVERWRITE locator ON unit TYPE object FLEXIBLE;
DEFINE FIELD OVERWRITE status ON unit TYPE string ASSERT $value IN ['in_window', 'out_of_window', 'redacted'];
DEFINE FIELD OVERWRITE grade ON unit TYPE string ASSERT $value IN ['official_text', 'original_log', 'exported_metric', 'agent_summary', 'recollection'];
DEFINE FIELD OVERWRITE hash ON unit TYPE string;
DEFINE FIELD OVERWRITE meta ON unit TYPE option<object> FLEXIBLE;
DEFINE INDEX OVERWRITE unit_type_status ON unit FIELDS type, status;

DEFINE TABLE IF NOT EXISTS label TYPE NORMAL SCHEMAFULL;
ALTER TABLE label TYPE NORMAL SCHEMAFULL;
DEFINE FIELD OVERWRITE unit ON label TYPE record<unit>;
DEFINE FIELD OVERWRITE tier ON label TYPE int ASSERT $value IN [0, 1, 2, 3];
DEFINE FIELD OVERWRITE dir ON label TYPE option<string> ASSERT $value = NONE OR $value IN ['for_goal', 'against_goal', 'mixed', 'neutral'];
DEFINE FIELD OVERWRITE issues ON label TYPE array<string> ASSERT array::all($value, |$i| $i IN ['saturation', 'dependency', 'deploy', 'config', 'monitoring', 'capacity']);
DEFINE FIELD OVERWRITE targets ON label TYPE array<string>;
DEFINE FIELD OVERWRITE role ON label TYPE option<string> ASSERT $value = NONE OR $value IN ['error', 'warning', 'metric', 'change', 'note'];
DEFINE FIELD OVERWRITE reason ON label TYPE option<string>;
DEFINE FIELD OVERWRITE quote ON label TYPE option<string>;
DEFINE FIELD OVERWRITE grade ON label TYPE string DEFAULT 'agent' ASSERT $value = 'agent';
DEFINE FIELD OVERWRITE chunk ON label TYPE string;
DEFINE FIELD OVERWRITE run ON label TYPE string;

DEFINE TABLE IF NOT EXISTS fact TYPE NORMAL SCHEMAFULL;
ALTER TABLE fact TYPE NORMAL SCHEMAFULL;
DEFINE FIELD OVERWRITE statement ON fact TYPE string;
DEFINE FIELD OVERWRITE status ON fact TYPE string DEFAULT 'proposed';
DEFINE FIELD OVERWRITE note ON fact TYPE option<string>;
DEFINE FIELD OVERWRITE tried ON fact TYPE option<string>;
DEFINE FIELD OVERWRITE evidence ON fact TYPE option<string>;
DEFINE FIELD OVERWRITE reasoning_type ON fact TYPE option<string>;
DEFINE FIELD OVERWRITE author ON fact TYPE option<string>;
DEFINE FIELD OVERWRITE lens ON fact TYPE option<string>;
DEFINE FIELD OVERWRITE learned_at ON fact TYPE datetime DEFAULT time::now();

DEFINE TABLE IF NOT EXISTS conclusion TYPE NORMAL SCHEMAFULL;
ALTER TABLE conclusion TYPE NORMAL SCHEMAFULL;
DEFINE FIELD OVERWRITE statement ON conclusion TYPE string;
DEFINE FIELD OVERWRITE ready ON conclusion TYPE bool DEFAULT false;
DEFINE FIELD OVERWRITE rating ON conclusion TYPE option<string>;
DEFINE FIELD OVERWRITE author ON conclusion TYPE option<string>;

DEFINE TABLE IF NOT EXISTS authority TYPE NORMAL SCHEMAFULL;
ALTER TABLE authority TYPE NORMAL SCHEMAFULL;
DEFINE FIELD OVERWRITE citation ON authority TYPE string;
DEFINE FIELD OVERWRITE verified ON authority TYPE bool DEFAULT false;
DEFINE FIELD OVERWRITE source_grade ON authority TYPE option<string>;

DEFINE TABLE IF NOT EXISTS critique TYPE NORMAL SCHEMAFULL;
ALTER TABLE critique TYPE NORMAL SCHEMAFULL;
DEFINE FIELD OVERWRITE lens ON critique TYPE string;
DEFINE FIELD OVERWRITE head ON critique TYPE string;
DEFINE FIELD OVERWRITE verdict ON critique TYPE string ASSERT $value IN ['fatal', 'damaging', 'survivable'];
DEFINE FIELD OVERWRITE text ON critique TYPE option<string>;
DEFINE FIELD OVERWRITE author ON critique TYPE option<string>;
DEFINE FIELD OVERWRITE answered ON critique TYPE bool DEFAULT false;

DEFINE TABLE IF NOT EXISTS answer TYPE NORMAL SCHEMAFULL;
ALTER TABLE answer TYPE NORMAL SCHEMAFULL;
DEFINE FIELD OVERWRITE text ON answer TYPE string;
DEFINE FIELD OVERWRITE author ON answer TYPE option<string>;

DEFINE TABLE IF NOT EXISTS cites TYPE RELATION IN fact OUT unit ENFORCED SCHEMALESS;
ALTER TABLE cites TYPE RELATION IN fact OUT unit ENFORCED SCHEMALESS;
DEFINE TABLE IF NOT EXISTS supports TYPE RELATION IN fact OUT conclusion ENFORCED SCHEMALESS;
ALTER TABLE supports TYPE RELATION IN fact OUT conclusion ENFORCED SCHEMALESS;
DEFINE TABLE IF NOT EXISTS undercuts TYPE RELATION IN fact OUT conclusion ENFORCED SCHEMALESS;
ALTER TABLE undercuts TYPE RELATION IN fact OUT conclusion ENFORCED SCHEMALESS;
DEFINE TABLE IF NOT EXISTS attacks TYPE RELATION IN critique OUT conclusion ENFORCED SCHEMALESS;
ALTER TABLE attacks TYPE RELATION IN critique OUT conclusion ENFORCED SCHEMALESS;
DEFINE TABLE IF NOT EXISTS answers TYPE RELATION IN answer OUT critique ENFORCED SCHEMALESS;
ALTER TABLE answers TYPE RELATION IN answer OUT critique ENFORCED SCHEMALESS;
DEFINE TABLE IF NOT EXISTS bears_on TYPE RELATION IN label OUT conclusion ENFORCED SCHEMALESS;
ALTER TABLE bears_on TYPE RELATION IN label OUT conclusion ENFORCED SCHEMALESS;
DEFINE TABLE IF NOT EXISTS relies_on TYPE RELATION IN conclusion OUT authority ENFORCED SCHEMALESS;
ALTER TABLE relies_on TYPE RELATION IN conclusion OUT authority ENFORCED SCHEMALESS;
DEFINE TABLE IF NOT EXISTS preserves TYPE RELATION IN unit OUT conclusion ENFORCED SCHEMALESS;
ALTER TABLE preserves TYPE RELATION IN unit OUT conclusion ENFORCED SCHEMALESS;
DEFINE FIELD OVERWRITE how ON preserves TYPE string ASSERT $value IN ['alert', 'dashboard', 'manual_note', 'not_captured'];
DEFINE TABLE IF NOT EXISTS verified_from TYPE RELATION IN authority OUT unit ENFORCED SCHEMALESS;
ALTER TABLE verified_from TYPE RELATION IN authority OUT unit ENFORCED SCHEMALESS;
DEFINE FIELD OVERWRITE read_by ON verified_from TYPE string;

DEFINE TABLE IF NOT EXISTS document TYPE NORMAL SCHEMAFULL;
ALTER TABLE document TYPE NORMAL SCHEMAFULL;
DEFINE FIELD OVERWRITE sha256 ON document TYPE option<string> ASSERT $value = NONE OR (string::matches($value, '^[0-9a-f]{64}$') AND $value = record::id($this.id));
DEFINE FIELD OVERWRITE media_type ON document TYPE string;
DEFINE FIELD OVERWRITE bytes ON document TYPE option<int> ASSERT $value = NONE OR $value >= 0;
DEFINE FIELD OVERWRITE capture ON document TYPE string ASSERT $value IN ['raw', 'rendered_text', 'none'];
DEFINE FIELD OVERWRITE source_uri ON document TYPE option<string>;
DEFINE FIELD OVERWRITE retrieved_at ON document TYPE option<datetime>;
DEFINE FIELD OVERWRITE original_name ON document TYPE option<string>;
DEFINE FIELD OVERWRITE integrity ON document TYPE string ASSERT $value IN ['ok', 'missing', 'corrupt', 'not_captured'] AND (($this.capture = 'none') = ($this.sha256 = NONE)) AND ($this.capture != 'none' OR $value = 'not_captured');
DEFINE FIELD OVERWRITE verified_at ON document TYPE option<datetime>;
DEFINE INDEX OVERWRITE document_sha256_unique ON document FIELDS sha256 UNIQUE;
DEFINE FIELD OVERWRITE document ON unit TYPE option<record<document>> REFERENCE ON DELETE REJECT ASSERT $value = NONE OR record::exists($value);
DEFINE INDEX OVERWRITE unit_document ON unit FIELDS document;

DEFINE INDEX OVERWRITE authority_citation_unique ON authority FIELDS citation UNIQUE;
