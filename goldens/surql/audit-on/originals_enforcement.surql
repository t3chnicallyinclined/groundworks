-- generated by groundworks/originals.py: a gated promotion counts only units whose original is verified
DEFINE EVENT OVERWRITE confirmed_needs_source_grade_originals ON TABLE fact WHEN $after.status = 'confirmed' AND ($before.status ?? NONE) != 'confirmed' THEN { IF !(count(SELECT VALUE id FROM $after.id->cites->unit WHERE (grade IN ['official_text', 'original_log', 'exported_metric'] AND status IN ['in_window']) AND document.integrity = 'ok') >= 1) { THROW 'originals refused by rule confirmed_needs_source_grade: fact.status may become "confirmed" only when its evidence units have a retrievable, verified original (document.integrity = \'ok\'); units with no original, or a missing, corrupt or never-captured one, do not count; refused ' + <string> $after.id; }; };
DEFINE EVENT OVERWRITE root_cause_needs_support_and_attack_originals ON TABLE conclusion WHEN $after.ready = true AND ($before.ready ?? NONE) != true THEN { IF !(count(SELECT VALUE id FROM $after.id<-preserves<-unit WHERE document.integrity = 'ok') >= 1) { THROW 'originals refused by rule root_cause_needs_support_and_attack: conclusion.ready may become true only when its evidence units have a retrievable, verified original (document.integrity = \'ok\'); units with no original, or a missing, corrupt or never-captured one, do not count; refused ' + <string> $after.id; }; };
DEFINE EVENT OVERWRITE authority_verified_needs_official_text_originals ON TABLE authority WHEN $after.verified = true AND ($before.verified ?? NONE) != true THEN { IF !(count(SELECT VALUE id FROM $after.id->verified_from->unit WHERE (grade = 'official_text' AND status IN ['in_window']) AND document.integrity = 'ok') >= 1) { THROW 'originals refused by rule authority_verified_needs_official_text: authority.verified may become true only when its evidence units have a retrievable, verified original (document.integrity = \'ok\'); units with no original, or a missing, corrupt or never-captured one, do not count; refused ' + <string> $after.id; }; };
