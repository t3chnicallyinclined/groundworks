-- list of 1
DEFINE EVENT OVERWRITE root_cause_needs_support_and_attack_independent_mode ON TABLE conclusion WHEN $after.ready = true AND ($before.ready ?? NONE) != true THEN { LET $principals = array::map($before.written_by ?? [], |$c| type::record('row_writer', [$after.id, $c]).principal); IF $auth = NONE OR $auth.principal = NONE OR array::len($principals) = 0 OR NONE INSIDE $principals OR $auth.principal INSIDE $principals { THROW 'independent promotion refused by rule root_cause_needs_support_and_attack: conclusion.ready may become True only by a credential bound to a declared principal that has written no part of the row; refused ' + <string> $after.id + ' by ' + <string> ($auth ?? 'root (no identity)') + ' (principal ' + <string> ($auth.principal ?? 'none declared') + '); principals of the row\'s writers: ' + <string> $principals; }; };  -- root_cause_needs_support_and_attack
