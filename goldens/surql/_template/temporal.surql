-- generated by groundworks/temporal.py from instance example_instance; do not edit by hand
-- valid time: when the claim held in the source (writer-supplied)
DEFINE FIELD OVERWRITE valid_from ON fact TYPE option<datetime>;
DEFINE FIELD OVERWRITE valid_to ON fact TYPE option<datetime>;
-- transaction time: when the graph recorded it, and every change of the gated value since

DEFINE FIELD OVERWRITE learned_at ON fact TYPE datetime DEFAULT time::now();
DEFINE FIELD OVERWRITE status_history ON fact TYPE array<object> DEFAULT [] ASSERT array::len($value) >= array::len($before ?? []) AND array::slice($value, 0, array::len($before ?? [])) = ($before ?? []);
DEFINE FIELD OVERWRITE status_history.*.status_before ON fact TYPE option<string>;
DEFINE FIELD OVERWRITE status_history.*.status_after ON fact TYPE option<string>;
DEFINE FIELD OVERWRITE status_history.*.at ON fact TYPE datetime;
DEFINE FIELD OVERWRITE status_history.*.by ON fact TYPE option<string>;
DEFINE EVENT OVERWRITE fact_status_history ON TABLE fact
  WHEN $event = 'UPDATE' AND $before.status != $after.status
  THEN {
    UPDATE $after.id SET status_history += {status_before: $before.status, status_after: $after.status, at: time::now(), by: $after.author};
  };
-- rows that existed before these fields were defined hold NONE and any later write on them would fail
-- coercion; both fields are backfilled in ONE statement (setting one alone trips coercion on the other)
UPDATE fact SET status_history = IF status_history = NONE { [] } ELSE { status_history }, learned_at = IF learned_at = NONE { time::now() } ELSE { learned_at } WHERE status_history = NONE OR learned_at = NONE;

