-- list of 2
DEFINE EVENT OVERWRITE confirmed_needs_source_grade_gate ON TABLE fact WHEN $event != 'DELETE' AND $after.status = 'confirmed' THEN { IF !(count(SELECT VALUE id FROM $after.id->cites->unit WHERE grade IN ['original', 'text_extract'] AND status IN ['usable']) >= 1) { THROW 'gate refused by rule confirmed_needs_source_grade: fact.status may become confirmed only when every clause of the rule holds, counted over every row whoever is writing; refused ' + <string> $after.id + ' by ' + <string> ($auth ?? 'root'); }; };  -- confirmed_needs_source_grade
DEFINE EVENT OVERWRITE conclusion_ready_gate ON TABLE conclusion WHEN $event != 'DELETE' AND $after.ready = true THEN { IF !(count(SELECT VALUE id FROM $after.id<-supports<-fact) >= 1 AND count(SELECT VALUE id FROM $after.id<-attacks<-critique) >= 1 AND count(SELECT VALUE id FROM $after.id<-attacks<-critique WHERE verdict = 'fatal') = 0 AND count(SELECT VALUE id FROM $after.id<-attacks<-critique WHERE verdict = 'damaging' AND answered = false) = 0) { THROW 'gate refused by rule conclusion_ready: conclusion.ready may become True only when every clause of the rule holds, counted over every row whoever is writing; refused ' + <string> $after.id + ' by ' + <string> ($auth ?? 'root'); }; };  -- conclusion_ready
