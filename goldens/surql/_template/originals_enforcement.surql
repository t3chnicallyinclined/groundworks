-- generated by groundworks/originals.py: a gated promotion counts only units whose original is verified
DEFINE EVENT OVERWRITE confirmed_needs_source_grade_originals ON TABLE fact WHEN $after.status = 'confirmed' AND ($before.status ?? NONE) != 'confirmed' THEN { IF !(count(SELECT VALUE id FROM $after.id->cites->unit WHERE (grade IN ['original', 'text_extract'] AND status IN ['usable']) AND document.integrity = 'ok') >= 1) { THROW 'originals refused by rule confirmed_needs_source_grade: fact.status may become "confirmed" only when its evidence units have a retrievable, verified original (document.integrity = \'ok\'); units with no original, or a missing, corrupt or never-captured one, do not count; refused ' + <string> $after.id; }; };
