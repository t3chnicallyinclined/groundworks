-- generated by groundworks/lens.py from instance example_instance; do not edit by hand
-- lens decision_maker (perspective, prompt-backed)
REMOVE TABLE IF EXISTS lens_decision_maker;
DEFINE TABLE OVERWRITE lens_decision_maker AS SELECT id AS label, unit, unit.status AS status, unit.grade AS grade, tier, dir, issues, targets, role, chunk FROM label WHERE unit.status IN ['usable'] AND (tier >= 2);
-- lens adversary (perspective, prompt-backed)
REMOVE TABLE IF EXISTS lens_adversary;
DEFINE TABLE OVERWRITE lens_adversary AS SELECT id AS label, unit, unit.status AS status, unit.grade AS grade, tier, dir, issues, targets, role, chunk FROM label WHERE unit.status IN ['usable'] AND (dir = 'against_goal');
-- frame nodes and the falls_under edge table (label -> consideration)
DEFINE TABLE OVERWRITE consideration SCHEMAFULL;
DEFINE FIELD OVERWRITE lens ON consideration TYPE string;
DEFINE FIELD OVERWRITE source ON consideration TYPE string;
DEFINE FIELD OVERWRITE node ON consideration TYPE string;
DEFINE FIELD OVERWRITE transcribed ON consideration TYPE string;
DEFINE INDEX OVERWRITE consideration_lens ON consideration FIELDS lens;
DEFINE TABLE OVERWRITE falls_under TYPE RELATION IN label OUT consideration SCHEMALESS;
-- frame of lens framework, transcribed from: authoritative document and location (e.g. guideline section, order page)
UPSERT consideration:framework__f1 SET lens="framework", source="authoritative document and location (e.g. guideline section, order page)", node="f1", transcribed="f1";
UPSERT consideration:framework__f2 SET lens="framework", source="authoritative document and location (e.g. guideline section, order page)", node="f2", transcribed="f2";
DELETE consideration WHERE lens = "framework" AND node NOT IN ["f1", "f2"];
