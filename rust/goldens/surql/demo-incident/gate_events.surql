-- list of 3
DEFINE EVENT OVERWRITE confirmed_needs_source_grade_gate ON TABLE fact WHEN $event != 'DELETE' AND $after.status = 'confirmed' THEN { IF !(count(SELECT VALUE id FROM $after.id->cites->unit WHERE grade IN ['official_text', 'original_log', 'exported_metric'] AND status IN ['in_window']) >= 1) { THROW 'gate refused by rule confirmed_needs_source_grade: fact.status may become confirmed only when every clause of the rule holds, counted over every row whoever is writing; refused ' + <string> $after.id + ' by ' + <string> ($auth ?? 'root'); }; };  -- confirmed_needs_source_grade
DEFINE EVENT OVERWRITE root_cause_needs_support_and_attack_gate ON TABLE conclusion WHEN $event != 'DELETE' AND $after.ready = true THEN { IF !(count(SELECT VALUE id FROM $after.id<-supports<-fact) >= 1 AND count(SELECT VALUE id FROM $after.id<-attacks<-critique) >= 1 AND count(SELECT VALUE id FROM $after.id<-preserves<-unit) >= 1 AND count(SELECT VALUE id FROM $after.id<-attacks<-critique WHERE verdict = 'fatal') = 0 AND count(SELECT VALUE id FROM $after.id<-attacks<-critique WHERE verdict = 'damaging' AND answered = false) = 0) { THROW 'gate refused by rule root_cause_needs_support_and_attack: conclusion.ready may become True only when every clause of the rule holds, counted over every row whoever is writing; refused ' + <string> $after.id + ' by ' + <string> ($auth ?? 'root'); }; };  -- root_cause_needs_support_and_attack
DEFINE EVENT OVERWRITE authority_verified_needs_official_text_gate ON TABLE authority WHEN $event != 'DELETE' AND $after.verified = true THEN { IF !(count(SELECT VALUE id FROM $after.id->verified_from->unit WHERE grade = 'official_text' AND status IN ['in_window']) >= 1) { THROW 'gate refused by rule authority_verified_needs_official_text: authority.verified may become True only when every clause of the rule holds, counted over every row whoever is writing; refused ' + <string> $after.id + ' by ' + <string> ($auth ?? 'root'); }; };  -- authority_verified_needs_official_text
