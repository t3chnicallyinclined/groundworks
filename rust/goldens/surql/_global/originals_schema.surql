DEFINE TABLE IF NOT EXISTS document SCHEMAFULL;
DEFINE FIELD IF NOT EXISTS sha256 ON document TYPE option<string> ASSERT $value = NONE OR (string::matches($value, '^[0-9a-f]{64}$') AND $value = record::id($this.id));
DEFINE FIELD IF NOT EXISTS media_type ON document TYPE string;
DEFINE FIELD IF NOT EXISTS bytes ON document TYPE option<int> ASSERT $value = NONE OR $value >= 0;
DEFINE FIELD IF NOT EXISTS capture ON document TYPE string ASSERT $value IN ['raw', 'rendered_text', 'none'];
DEFINE FIELD IF NOT EXISTS source_uri ON document TYPE option<string>;
DEFINE FIELD IF NOT EXISTS retrieved_at ON document TYPE option<datetime>;
DEFINE FIELD IF NOT EXISTS original_name ON document TYPE option<string>;
DEFINE FIELD IF NOT EXISTS integrity ON document TYPE string ASSERT $value IN ['ok', 'missing', 'corrupt', 'not_captured'] AND (($this.capture = 'none') = ($this.sha256 = NONE)) AND ($this.capture != 'none' OR $value = 'not_captured');
DEFINE FIELD IF NOT EXISTS verified_at ON document TYPE option<datetime>;
DEFINE INDEX IF NOT EXISTS document_sha256_unique ON document FIELDS sha256 UNIQUE;
DEFINE FIELD IF NOT EXISTS document ON unit TYPE option<record<document>> REFERENCE ON DELETE REJECT ASSERT $value = NONE OR record::exists($value);
DEFINE INDEX IF NOT EXISTS unit_document ON unit FIELDS document;
