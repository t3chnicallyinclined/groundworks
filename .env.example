# Copy to .env and edit. docker compose reads .env from the project root automatically.

# --- surrealdb service ---
# Root credentials for the self-hosted SurrealDB. Changing these from the default also
# means changing them everywhere a client connects with root/root today: the `engine`
# service's demo command (scripts/run_instance.py takes no credential flags and relies on
# xscholar/db.py's root/root default) and the `backup` service below. Until that is wired
# through, leave these at the default for the compose demo, or update both services to
# match.
SURREAL_USER=root
SURREAL_PASS=root

# Host port the surrealdb service is published on, bound to 127.0.0.1 only (see
# compose.yaml). Change if 8000 is taken locally.
SURREAL_PORT=8000

# --- backup service (profile "ops") ---
# How often `surreal export` runs, in seconds. Default: once every 24 hours.
BACKUP_INTERVAL_SECONDS=86400
